{
  "name": "safespace-phase2",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "lint": "cd .. && website/node_modules/.bin/eslint website/src website/bench website/e2e website/*.config.js network-agent scripts",
    "typecheck": "tsc --noEmit",
    "format": "cd .. && website/node_modules/.bin/prettier --write --ignore-path .gitignore --ignore-path .prettierignore \"**/*.{js,jsx,mjs,ts,json,md,yml,yaml,css,html}\"",
    "format:check": "cd .. && website/node_modules/.bin/prettier --check --ignore-path .gitignore --ignore-path .prettierignore \"**/*.{js,jsx,mjs,ts,json,md,yml,yaml,css,html}\"",
    "bundle:check": "node ../scripts/check-bundle.mjs",
    "android:sync": "cap sync android",
    "test:browser": "playwright test",
    "benchmark": "node bench/run.mjs"
  },
  "dependencies": {
    "@capacitor-community/bluetooth-le": "^8.3.0",
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@tensorflow-models/coco-ssd": "^2.2.3",
    "@tensorflow/tfjs": "^4.22.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@capacitor/cli": "^8.6.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.19.3",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.5.0",
    "jpeg-js": "0.4.4",
    "jsdom": "26.1.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vite": "^6.0.5",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.1"
    }
  },
  "license": "MIT",
  "author": {
    "name": "Yeshika0900",
    "url": "https://github.com/Yeshika0900"
  }
}
